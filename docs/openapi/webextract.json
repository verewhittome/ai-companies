{
  "openapi": "3.0.0",
  "info": {
    "title": "webextract",
    "description": "Turn any URL into clean, LLM-ready markdown plus structured metadata and links. Built for RAG pipelines and AI agents.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://webextract-api-kxu8.onrender.com" }],
  "paths": {
    "/extract": {
      "post": {
        "summary": "Extract clean content from a URL",
        "description": "Fetch a URL and return the main content as markdown plus metadata and links.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "description": "The URL to extract" },
                  "formats": { "type": "array", "items": { "type": "string", "enum": ["markdown", "text", "html", "links"] } },
                  "selector": { "type": "string", "description": "Optional CSS selector to narrow extraction" },
                  "includeMetadata": { "type": "boolean" },
                  "includeLinks": { "type": "boolean" }
                }
              },
              "example": { "url": "https://example.com", "formats": ["markdown"], "includeMetadata": true }
            }
          }
        },
        "responses": { "200": { "description": "Extraction result (title, markdown, metadata, links, wordCount)" } }
      }
    },
    "/batch": {
      "post": {
        "summary": "Extract multiple URLs in one call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["urls"],
                "properties": {
                  "urls": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
                  "formats": { "type": "array", "items": { "type": "string" } },
                  "includeMetadata": { "type": "boolean" }
                }
              },
              "example": { "urls": ["https://example.com", "https://en.wikipedia.org/wiki/API"], "formats": ["markdown"] }
            }
          }
        },
        "responses": { "200": { "description": "Array of extraction results" } }
      }
    },
    "/health": {
      "get": { "summary": "Health check", "responses": { "200": { "description": "Service status" } } }
    }
  }
}
