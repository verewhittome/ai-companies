{
  "name": "ai-companies",
  "version": "0.1.0",
  "private": true,
  "description": "Experiments with AI-generated companies.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "experiment": "tsx src/run-experiment.ts",
    "dev": "tsx src/run-experiment.ts",
    "serve": "tsx src/webextract/server.ts",
    "start": "node dist/webextract/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@mozilla/readability": "^0.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "franc": "^6.2.0",
    "jsdom": "^25.0.1",
    "libphonenumber-js": "^1.11.4",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.1",
    "stripe": "^17.5.0",
    "turndown": "^7.2.0",
    "ua-parser-js": "^1.0.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.13.0",
    "@types/turndown": "^5.0.5",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
