# Company-brief experiment runner
ANTHROPIC_API_KEY=

# webextract API (src/webextract)
PORT=8080
# Comma-separated keys for direct sales (checked against X-API-Key). Leave blank for open/dev.
WEBEXTRACT_API_KEYS=
# Shared secret RapidAPI forwards as X-RapidAPI-Proxy-Secret. Set when listing on RapidAPI.
RAPIDAPI_PROXY_SECRET=
# Per-key/IP requests per minute on the direct (non-RapidAPI) path.
RATE_LIMIT_PER_MIN=60
